# === Clerk — autenticación y metadatos del ranking ===
# Entornos: Production, Preview, Development

# Clave pública de Clerk (cliente).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clave secreta de Clerk (servidor).
CLERK_SECRET_KEY=

# Ruta de inicio de sesión.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Ruta de registro.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# A dónde ir tras iniciar sesión.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/postular

# A dónde ir tras registrarse.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/postular

# === Administración ===
# Correos que pueden aprobar plazas en /revision, separados por coma.
# Entornos: Production, Preview, Development
RANKING_ADMIN_EMAILS=

# === Supabase (paridad con Vercel original; el código Next.js actual NO las usa) ===
# Entornos: Production, Preview, Development

# URL del proyecto Supabase (si se conecta en el futuro).
NEXT_PUBLIC_SUPABASE_URL=

# Clave anon pública de Supabase (si se conecta en el futuro).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
